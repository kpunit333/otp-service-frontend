# ==============================================================================
# Production Configuration (.env.production)
# Overrides .env when running with --configuration=production
# ==============================================================================

# Application Meta
NEXT_PUBLIC_APP_NAME="OTP Shield"
NEXT_PUBLIC_APP_DESCRIPTION="Next-Gen Enterprise OTP & Verification Delivery Platform"
NEXT_PUBLIC_APP_URL="https://app.otpshield.io"
NEXT_PUBLIC_APP_ENV="production"

# Backend & API Gateways
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_BACKEND_URL="https://api.otpshield.io"
NEXT_PUBLIC_ENABLE_MOCK_API="false"

# Core OTP Security Engine (Server-side)
OTP_SECRET_KEY="production-cryptographic-key-high-entropy-signature-prod"
OTP_EXPIRY_SECONDS=300
OTP_CODE_LENGTH=6
OTP_MAX_VERIFY_ATTEMPTS=3

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=5
RATE_LIMIT_WINDOW_SECONDS=600
