# ==============================================================================
# Base Environment Configuration (.env)
# Used by default when no --configuration is specified.
# Overridden when --configuration=<name> is provided.
# ==============================================================================

# Application Meta
NEXT_PUBLIC_APP_NAME="OTP Shield"
NEXT_PUBLIC_APP_DESCRIPTION="Enterprise OTP & Verification Delivery Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="default"

# Backend & API Gateways
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"
NEXT_PUBLIC_ENABLE_MOCK_API="true"

# Localization & Format
NEXT_PUBLIC_DEFAULT_LOCALE="en-US"
NEXT_PUBLIC_DEFAULT_TIMEZONE="UTC"

# Core OTP Security Engine (Server-side)
OTP_SECRET_KEY="otp-shield-base-secret-cryptographic-key-default"
OTP_EXPIRY_SECONDS=300
OTP_CODE_LENGTH=6
OTP_MAX_VERIFY_ATTEMPTS=3

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=5
RATE_LIMIT_WINDOW_SECONDS=600
