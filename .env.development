# ==============================================================================
# Development Configuration (.env.development)
# Overrides .env when running with --configuration=development
# ==============================================================================

# Application Meta
NEXT_PUBLIC_APP_NAME="OTP Shield (Dev)"
NEXT_PUBLIC_APP_DESCRIPTION="Enterprise OTP & Verification Delivery Platform [Development]"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Backend & API Gateways
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"
NEXT_PUBLIC_ENABLE_MOCK_API="true"

# Core OTP Security Engine (Server-side)
OTP_SECRET_KEY="development-secret-cryptographic-key-for-local-testing"
OTP_EXPIRY_SECONDS=300
OTP_CODE_LENGTH=6
OTP_MAX_VERIFY_ATTEMPTS=3

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=300
