{
  "name": "otp-service-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/switch-env.js dev",
    "dev:development": "node ./scripts/switch-env.js dev --configuration=dev",
    "dev:staging": "node ./scripts/switch-env.js dev --configuration=staging",
    "dev:production": "node ./scripts/switch-env.js dev --configuration=prod",
    "build": "node ./scripts/switch-env.js build",
    "start": "node ./scripts/switch-env.js start",
    "switch-env": "node ./scripts/switch-env.js",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5"
  }
}