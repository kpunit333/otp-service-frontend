# ==============================================================================
# OTP Service Frontend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, set these variables in your deployment platform (Vercel, AWS, etc.).

# ------------------------------------------------------------------------------
# 1. APPLICATION & PUBLIC SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="OTP Shield"
NEXT_PUBLIC_APP_DESCRIPTION="Next-Gen Enterprise OTP & Verification Delivery Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development" # development | staging | production

# Client-facing API Base URL (leave empty for same-origin Next.js API routes)
NEXT_PUBLIC_API_BASE_URL=""

# Toggle live simulator mock data mode (true enables realistic demo data without third-party credentials)
NEXT_PUBLIC_ENABLE_MOCK_API="true"

# Default locale & timezone
NEXT_PUBLIC_DEFAULT_LOCALE="en-US"
NEXT_PUBLIC_DEFAULT_TIMEZONE="UTC"

# ------------------------------------------------------------------------------
# 2. OTP ENGINE & SECURITY CONFIGURATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Cryptographic secret for signing verification tokens (min 32 characters)
OTP_SECRET_KEY="super-secret-cryptographic-key-change-in-production-min-32-chars"

# Expiration window in seconds (e.g., 300 = 5 minutes)
OTP_EXPIRY_SECONDS=300

# Length of generated OTP (typically 4, 6, or 8)
OTP_CODE_LENGTH=6

# Max invalid verification attempts before locking
OTP_MAX_VERIFY_ATTEMPTS=3

# Rate limit: Max OTP requests per recipient within time window
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=5
RATE_LIMIT_WINDOW_SECONDS=600

# ------------------------------------------------------------------------------
# 3. SMS GATEWAYS (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# Twilio Provider
TWILIO_ACCOUNT_SID="AC_mock_twilio_account_sid"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token"
TWILIO_PHONE_NUMBER="+18005550199"

# AWS SNS Provider
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA_MOCK_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="mock_aws_secret_access_key"

# ------------------------------------------------------------------------------
# 4. EMAIL GATEWAYS (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# SendGrid Provider
SENDGRID_API_KEY="SG.mock_sendgrid_api_key"
SENDGRID_FROM_EMAIL="verify@otpshield.io"

# ------------------------------------------------------------------------------
# 5. WHATSAPP GATEWAY (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
WHATSAPP_BUSINESS_ACCOUNT_ID="mock_whatsapp_account_id"
WHATSAPP_API_TOKEN="mock_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="mock_whatsapp_phone_number_id"

# ------------------------------------------------------------------------------
# 6. DATABASE & CACHE (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/otp_service_db?schema=public"
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 7. TELEMETRY & OBSERVABILITY
# ------------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
